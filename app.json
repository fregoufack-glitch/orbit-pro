{
  "expo": {
    "name": "Orbit Pro",
    "slug": "orbit-pro",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "orbitpro",
    "userInterfaceStyle": "automatic",
    "splash": {
      "backgroundColor": "#0A0A0F",
      "resizeMode": "contain"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.orbitpro.app",
      "infoPlist": {
        "UIBackgroundModes": ["fetch", "remote-notification"],
        "GADApplicationIdentifier": "ca-app-pub-3940256099942544~3347511713",
        "SKAdNetworkItems": [
          { "SKAdNetworkIdentifier": "cstr6suwn9.skadnetwork" }
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0A0A0F"
      },
      "package": "com.orbitpro.app",
      "permissions": [
        "RECEIVE_BOOT_COMPLETED",
        "WAKE_LOCK",
        "SCHEDULE_EXACT_ALARM",
        "VIBRATE"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-localization",
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#00D9A5"
        }
      ],
      "expo-background-fetch",
      "expo-task-manager",
      [
        "expo-updates",
        {
          "username": "orbitpro"
        }
      ],
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-3940256099942544~3347511713",
          "iosAppId": "ca-app-pub-3940256099942544~1458002511"
        }
      ],
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "OrbitWidget",
              "label": "Orbit Pro",
              "minWidth": "250dp",
              "minHeight": "180dp",
              "description": "Track your habits, streaks, and XP",
              "targetCellWidth": 3,
              "targetCellHeight": 2,
              "resizeMode": "horizontal|vertical"
            }
          ]
        }
      ]
    ],
    "updates": {
      "enabled": true,
      "fallbackToCacheTimeout": 30000,
      "url": "https://u.expo.dev/orbit-pro"
    },
    "runtimeVersion": {
      "policy": "sdkVersion"
    },
    "experiments": {
      "typedRoutes": true
    },
    "sdkVersion": "54"
  }
}
